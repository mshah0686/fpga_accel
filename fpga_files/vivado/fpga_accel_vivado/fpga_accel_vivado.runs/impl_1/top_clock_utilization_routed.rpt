# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells spi_clk_IBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y16 [get_cells fpga_100mhz_clk_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports fpga_100mhz_clk]
set_property LOC IOB_X0Y78 [get_ports spi_clk]

# Clock net "spi_clk_IBUF_BUFG" driven by instance "spi_clk_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_spi_clk_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_spi_clk_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="spi_clk_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_spi_clk_IBUF_BUFG}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup

# Clock net "fpga_100mhz_clk_IBUF_BUFG" driven by instance "fpga_100mhz_clk_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_fpga_100mhz_clk_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_fpga_100mhz_clk_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="fpga_100mhz_clk_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_fpga_100mhz_clk_IBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup
