      $var wire 32 0" DATA_COUNTER_WIDTH [31:0] $end
      $var wire 32 T! shift_reg [31:0] $end
      $var wire 5 U! recieved_count [4:0] $end
      $var wire 1 V! last_txn_flag $end
     $upscope $end
     $scope module spi_tx_u $end
      $var wire 32 X! TXN_WIDTH [31:0] $end
      $var wire 32 Z! DATA_WIDTH [31:0] $end
      $var wire 1 B! spi_clk $end
      $var wire 1 / spi_poci $end
      $var wire 1 D! spi_cs $end
      $var wire 16 N! fifo_read_data_in [15:0] $end
      $var wire 1 =! fifo_empty_in $end
      $var wire 1 >! r_en_out $end
      $var wire 4 M! dbg [3:0] $end
      $var wire 2 ~! INIT [1:0] $end
      $var wire 2 !" WAIT_TO_SEND [1:0] $end
      $var wire 2 1" SEND [1:0] $end
      $var wire 2 2" SKIP [1:0] $end
      $var wire 2 W! next_state [1:0] $end
      $var wire 2 4 current_state [1:0] $end
      $var wire 16 5 send_data_shift_reg [15:0] $end
      $var wire 5 6 cycle_count [4:0] $end
      $var wire 5 3" LAST_TXN_CYCLE [4:0] $end
     $upscope $end
