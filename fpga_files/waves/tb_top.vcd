      $var wire 1 * data_valid $end
      $var wire 1 <" system_ready $end
      $var wire 32 ]! spi_data_in [31:0] $end
      $var wire 1 ^! spi_data_valid $end
      $var wire 4 - dbg [3:0] $end
      $var wire 32 N! sync_data_out [31:0] $end
      $var wire 1 X! sync_valid_out $end
      $var wire 1 . valid_q $end
      $var wire 1 / valid_rising_edge_flag $end
      $var wire 1 * downstream_handshake $end
      $var wire 1 * downstream_valid_q $end
      $scope module data_sync $end
       $var wire 32 {! SIZE [31:0] $end
       $var wire 1 h! clk $end
       $var wire 32 ]! in [31:0] $end
       $var wire 32 N! out [31:0] $end
       $var wire 32 Y! q_1 [31:0] $end
      $upscope $end
      $scope module valid_sync $end
       $var wire 32 =" SIZE [31:0] $end
       $var wire 1 h! clk $end
       $var wire 1 _! in [0:0] $end
       $var wire 1 Z! out [0:0] $end
       $var wire 1 [! q_1 [0:0] $end
      $upscope $end
     $upscope $end
     $scope module spi_rx_u $end
      $var wire 32 {! DATA_WIDTH [31:0] $end
      $var wire 1 e! spi_clk $end
      $var wire 1 f! spi_pico $end
      $var wire 1 g! spi_cs $end
      $var wire 32 ]! data_out [31:0] $end
      $var wire 1 ^! data_valid_flag $end
      $var wire 4 u! led_dbg [3:0] $end
      $var wire 4 v! pwd_debug [3:0] $end
      $var wire 32 >" DATA_COUNTER_WIDTH [31:0] $end
      $var wire 32 w! shift_reg [31:0] $end
      $var wire 5 x! recieved_count [4:0] $end
      $var wire 1 y! last_txn_flag $end
     $upscope $end
     $scope module spi_tx_u $end
      $var wire 32 {! TXN_WIDTH [31:0] $end
      $var wire 32 }! DATA_WIDTH [31:0] $end
      $var wire 1 e! spi_clk $end
      $var wire 1 3 spi_poci $end
      $var wire 1 g! spi_cs $end
      $var wire 16 q! fifo_read_data_in [15:0] $end
      $var wire 1 `! fifo_empty_in $end
      $var wire 1 a! r_en_out $end
      $var wire 4 p! dbg [3:0] $end
      $var wire 2 /" INIT [1:0] $end
      $var wire 2 0" WAIT_TO_SEND [1:0] $end
      $var wire 2 ?" SEND [1:0] $end
      $var wire 2 @" SKIP [1:0] $end
      $var wire 2 z! next_state [1:0] $end
      $var wire 2 8 current_state [1:0] $end
      $var wire 16 9 send_data_shift_reg [15:0] $end
      $var wire 5 : cycle_count [4:0] $end
      $var wire 5 A" LAST_TXN_CYCLE [4:0] $end
     $upscope $end
    $upscope $end
    $scope module timer_u $end
     $var wire 1 h! clk $end
     $var wire 1 O start $end
     $var wire 1 M clear $end
     $var wire 1 N stop $end
     $var wire 8 " count [7:0] $end
     $var wire 1 P timer_en $end
     $var wire 4 a tens_place [3:0] $end
     $var wire 4 b ones_place [3:0] $end
     $var wire 4 \! dbg [3:0] $end
     $var wire 4 0 led_dbg [3:0] $end
     $var wire 32 B" CYCLES_PER_SECOND [31:0] $end
     $var wire 32 C" CYCLE_COUNTER_WIDTH [31:0] $end
     $var wire 32 D" COUNTER_MAX [31:0] $end
     $var wire 8 " count_q [7:0] $end
     $var wire 25 1 cycle_counter [24:0] $end
     $var wire 1 2 dummy_started $end
     $var wire 32 E" i [31:0] $end
    $upscope $end
   $upscope $end
  $upscope $end
 $upscope $end
$enddefinitions $end


