     $var wire 32 ., SHIFT [31:0] $end
     $var wire 32 ++ r [31:0] $end
     $var wire 32 +, c [31:0] $end
    $upscope $end
   $upscope $end
  $upscope $end
 $upscope $end
$enddefinitions $end


